{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simplemindsstudios.com/schemas/hcbl/burst.v3.schema.json",
  "title": "HCBL Observatory Burst v3",
  "type": "object",
  "required": ["burst_id", "captured_at", "source", "initial_state", "history"],
  "properties": {
    "burst_id": {"type": "string"},
    "captured_at": {"type": "string", "format": "date-time"},
    "source": {
      "type": "object",
      "required": ["kind", "reference"],
      "properties": {
        "kind": {"type": "string", "enum": ["conversation", "artifact", "repository", "field_note", "image", "document", "other"]},
        "reference": {"type": "string"},
        "provenance_status": {"type": "string", "enum": ["attributable", "remembered", "unavailable", "disputed"]}
      }
    },
    "initial_state": {"$ref": "#/$defs/assessment"},
    "history": {
      "type": "array",
      "items": {"$ref": "#/$defs/revision"}
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "target": {"type": "string"},
          "relation": {"type": "string", "enum": ["converges_with", "contradicts", "adjacent_to", "derived_from", "reframes", "evolves_into"]},
          "influence": {"type": "string", "enum": ["independent", "influenced", "directly_inherited", "unknown"]}
        }
      }
    }
  },
  "$defs": {
    "assessment": {
      "type": "object",
      "required": ["classification", "epistemic_status", "confidence"],
      "properties": {
        "classification": {"type": "string"},
        "epistemic_status": {"type": "string", "enum": ["witnessed", "measured", "modeled", "inferred", "unknown", "disputed"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "burst_intensity": {"type": "number", "minimum": 0, "maximum": 1},
        "persistence": {"type": "number", "minimum": 0, "maximum": 1},
        "cross_project_recurrence": {"type": "number", "minimum": 0, "maximum": 1},
        "conversion": {"type": "number", "minimum": 0, "maximum": 1},
        "contradiction_pressure": {"type": "number", "minimum": 0, "maximum": 1},
        "novelty": {"type": "number", "minimum": 0, "maximum": 1},
        "recognition_lag_days": {"type": "number", "minimum": 0},
        "trajectory": {"type": "string", "enum": ["strengthening", "stable", "weakening", "mutating", "dormant", "superseded", "unresolved"]},
        "sample_size": {"type": "integer", "minimum": 0},
        "supporting_evidence": {"type": "array", "items": {"type": "string"}},
        "counterevidence": {"type": "array", "items": {"type": "string"}}
      }
    },
    "revision": {
      "type": "object",
      "required": ["evaluated_at", "assessment", "synthesizer"],
      "properties": {
        "evaluated_at": {"type": "string", "format": "date-time"},
        "assessment": {"$ref": "#/$defs/assessment"},
        "synthesizer": {"type": "string"},
        "reason": {"type": "string"},
        "rejected_hypotheses": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
